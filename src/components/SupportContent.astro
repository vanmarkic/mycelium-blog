---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/translations';
import { getLangFromUrl } from '../i18n/utils';
import ProjectCard from './ProjectCard.astro';
import { getAllProjects } from '../utils/projects';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const projects = getAllProjects();
---

<BaseLayout
  title={t.nav.support}
  description={t.support.subtitle}
>
  <!-- Hero Section - Sobre et élégant -->
  <section class="max-w-4xl mx-auto text-center mb-16">
    <div class="inline-block px-4 py-2 bg-mycelium-100 dark:bg-mycelium-900/30 border border-mycelium-300 dark:border-mycelium-700 rounded-full mb-6">
      <span class="text-mycelium-700 dark:text-mycelium-300 text-sm font-medium">💚 Open Source & Impact Social</span>
    </div>

    <h1 class="text-5xl md:text-6xl font-bold mb-6 text-gray-900 dark:text-gray-100">
      {t.support.title}
    </h1>

    <p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed">
      {t.support.subtitle}
    </p>

    <!-- Quick stats - Minimaliste -->
    <div class="flex justify-center gap-8 mt-12">
      <div class="text-center">
        <div class="text-3xl font-bold text-mycelium-600 dark:text-mycelium-400">{projects.length}+</div>
        <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">{t.support.stats.projects}</div>
      </div>
      <div class="text-center">
        <div class="text-3xl font-bold text-mycelium-600 dark:text-mycelium-400">100%</div>
        <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">{t.support.stats.openSource}</div>
      </div>
      <div class="text-center">
        <div class="text-3xl font-bold">🇧🇪</div>
        <div class="text-sm text-gray-600 dark:text-gray-400 mt-1">{t.support.stats.madeIn}</div>
      </div>
    </div>
  </section>

  <!-- Mission Section - Épurée -->
  <section class="mb-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-8 text-center text-gray-900 dark:text-gray-100">
        {t.support.mission.title}
      </h2>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:border-mycelium-400 dark:hover:border-mycelium-600 transition-colors">
          <div class="text-3xl mb-3">🛠️</div>
          <h3 class="text-lg font-bold mb-2 text-gray-900 dark:text-gray-100">{t.support.mission.development.title}</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm">{t.support.mission.development.desc}</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:border-mycelium-400 dark:hover:border-mycelium-600 transition-colors">
          <div class="text-3xl mb-3">📚</div>
          <h3 class="text-lg font-bold mb-2 text-gray-900 dark:text-gray-100">{t.support.mission.docs.title}</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm">{t.support.mission.docs.desc}</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:border-mycelium-400 dark:hover:border-mycelium-600 transition-colors">
          <div class="text-3xl mb-3">🌱</div>
          <h3 class="text-lg font-bold mb-2 text-gray-900 dark:text-gray-100">{t.support.mission.innovation.title}</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm">{t.support.mission.innovation.desc}</p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 hover:border-mycelium-400 dark:hover:border-mycelium-600 transition-colors">
          <div class="text-3xl mb-3">⚡</div>
          <h3 class="text-lg font-bold mb-2 text-gray-900 dark:text-gray-100">{t.support.mission.infrastructure.title}</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm">{t.support.mission.infrastructure.desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Grid - Design sobre -->
  <section class="mb-16">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold mb-4 text-center text-gray-900 dark:text-gray-100">
        {t.support.projects.title}
      </h2>
      <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-2xl mx-auto">
        {t.support.projects.subtitle}
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map(project => (
          <ProjectCard
            emoji={project.emoji}
            title={project.title}
            tagline={project.tagline}
            category={project.category}
            color={project.color}
            slug={project.slug}
            fundingGoal={project.fundingGoal}
            fundingCurrency={project.fundingCurrency}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Donation Options - Simplifié -->
  <section class="mb-16">
    <div class="max-w-4xl mx-auto bg-gradient-to-br from-mycelium-50 to-green-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl border border-mycelium-200 dark:border-mycelium-800 p-8 md:p-12">
      <h2 class="text-3xl font-bold mb-6 text-center text-gray-900 dark:text-gray-100">
        Comment soutenir ?
      </h2>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- PayPal -->
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <div class="text-3xl mb-3 text-center">💳</div>
          <h3 class="text-lg font-bold mb-2 text-center text-gray-900 dark:text-gray-100">PayPal</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 text-center mb-4">
            Don rapide et sécurisé
          </p>
          <a
            href="https://www.paypal.com/paypalme/dragovanmarkic"
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full px-4 py-2 bg-mycelium-600 hover:bg-mycelium-700 text-white text-center rounded-lg font-medium transition-colors"
          >
            Donner via PayPal
          </a>
        </div>

        <!-- Open Collective -->
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <div class="text-3xl mb-3 text-center">🌐</div>
          <h3 class="text-lg font-bold mb-2 text-center text-gray-900 dark:text-gray-100">Open Collective</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 text-center mb-4">
            Transparence totale
          </p>
          <a
            href="https://opencollective.com/mycelium-dev"
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full px-4 py-2 bg-mycelium-600 hover:bg-mycelium-700 text-white text-center rounded-lg font-medium transition-colors"
          >
            Voir sur OC
          </a>
        </div>

        <!-- Virement -->
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700">
          <div class="text-3xl mb-3 text-center">🏦</div>
          <h3 class="text-lg font-bold mb-2 text-center text-gray-900 dark:text-gray-100">Virement</h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 text-center mb-4">
            IBAN disponible
          </p>
          <button
            onclick="navigator.clipboard.writeText('BE37 3770 8459 2828'); alert('IBAN copié !')"
            class="block w-full px-4 py-2 bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-900 dark:text-gray-100 text-center rounded-lg font-medium transition-colors"
          >
            Copier l'IBAN
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Thank You Section - Minimaliste -->
  <section class="max-w-4xl mx-auto text-center">
    <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-8 md:p-12">
      <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-gray-100">
        Merci de votre soutien 💚
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-8">
        Chaque contribution, quelle que soit sa taille, permet de maintenir ces projets indépendants, open source et accessibles à tous.
      </p>

      <div class="flex flex-wrap justify-center gap-6">
        <div class="text-center">
          <div class="text-2xl mb-2">🌍</div>
          <div class="text-sm font-medium text-gray-700 dark:text-gray-300">Impact global</div>
        </div>
        <div class="text-center">
          <div class="text-2xl mb-2">🤝</div>
          <div class="text-sm font-medium text-gray-700 dark:text-gray-300">Solidarité</div>
        </div>
        <div class="text-center">
          <div class="text-2xl mb-2">💻</div>
          <div class="text-sm font-medium text-gray-700 dark:text-gray-300">Open Source</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
