---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/markdown';
import { Markdown } from '@astrojs/markdown-remark';

export async function getStaticPaths() {
  const contentDir = new URL('../../../content', import.meta.url).pathname;
  const posts = await getPublishedPosts(contentDir);

  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { frontmatter, content } = post;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="max-w-4xl mx-auto">
    <!-- Header -->
    <header class="mb-8">
      <h1 class="text-4xl font-bold text-gray-100 mb-4">
        {frontmatter.title}
      </h1>

      <div class="flex items-center gap-4 text-sm text-gray-400">
        <time datetime={frontmatter.date}>
          {new Date(frontmatter.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>

        {frontmatter.privacy === 'internal' && (
          <span class="px-2 py-1 bg-gray-700 text-gray-300 rounded text-xs">
            Internal
          </span>
        )}
      </div>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mt-4">
        {frontmatter.tags.map(tag => (
          <span class="px-3 py-1 bg-gray-800 text-mycelium-300 rounded-full text-sm">
            {tag}
          </span>
        ))}
      </div>

      <!-- Metadata -->
      {(frontmatter.repos.length > 0 || frontmatter.skills.length > 0 || frontmatter.patterns.length > 0) && (
        <div class="mt-6 p-4 bg-gray-800 rounded-lg space-y-2 text-sm">
          {frontmatter.repos.length > 0 && (
            <div>
              <span class="text-gray-400">Repos:</span>{' '}
              <span class="text-gray-200">{frontmatter.repos.join(', ')}</span>
            </div>
          )}
          {frontmatter.skills.length > 0 && (
            <div>
              <span class="text-gray-400">Skills:</span>{' '}
              {frontmatter.skills.map((skill, i) => (
                <span>
                  <a href={`/skills/${skill}`} class="text-mycelium-400 hover:text-mycelium-300">
                    {skill}
                  </a>
                  {i < frontmatter.skills.length - 1 && ', '}
                </span>
              ))}
            </div>
          )}
          {frontmatter.patterns.length > 0 && (
            <div>
              <span class="text-gray-400">Patterns:</span>{' '}
              {frontmatter.patterns.map((pattern, i) => (
                <span>
                  <a href={`/patterns/${pattern}`} class="text-mycelium-400 hover:text-mycelium-300">
                    {pattern}
                  </a>
                  {i < frontmatter.patterns.length - 1 && ', '}
                </span>
              ))}
            </div>
          )}
        </div>
      )}
    </header>

    <!-- Content -->
    <div class="prose prose-invert prose-lg max-w-none">
      <div set:html={content} />
    </div>

    <!-- Related Posts (Mycelium Links) -->
    {frontmatter.relatedTo && frontmatter.relatedTo.length > 0 && (
      <section class="mt-12 pt-8 border-t border-gray-800">
        <h2 class="text-2xl font-bold text-gray-100 mb-4">
          🍄 Mycelium Links
        </h2>
        <p class="text-gray-400 mb-6">
          Connected through shared concepts, tools, and patterns
        </p>
        <div class="space-y-3">
          {frontmatter.relatedTo.map(relatedSlug => (
            <a
              href={`/posts/${relatedSlug}`}
              class="block p-4 bg-gray-800 rounded-lg hover:bg-gray-750 hover:border-mycelium-600 border border-transparent transition-all"
            >
              <span class="text-mycelium-400 hover:text-mycelium-300">
                {relatedSlug}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Back to home -->
    <div class="mt-12">
      <a
        href="/"
        class="text-mycelium-400 hover:text-mycelium-300 transition-colors"
      >
        ← Back to all posts
      </a>
    </div>
  </article>
</BaseLayout>
