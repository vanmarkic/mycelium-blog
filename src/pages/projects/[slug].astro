---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllProjects, getProjectBySlug } from '../../utils/projects';

export async function getStaticPaths() {
  const projects = getAllProjects();
  return projects.map(project => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug);

if (!project) {
  return Astro.redirect('/404');
}

const colorClasses = {
  red: 'from-red-500 to-red-600 dark:from-red-400 dark:to-red-500',
  amber: 'from-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-500',
  purple: 'from-purple-500 to-purple-600 dark:from-purple-400 dark:to-purple-500',
  cyan: 'from-cyan-500 to-cyan-600 dark:from-cyan-400 dark:to-cyan-500',
  mycelium: 'from-mycelium-500 to-mycelium-600 dark:from-mycelium-400 dark:to-mycelium-500',
  orange: 'from-orange-500 to-orange-600 dark:from-orange-400 dark:to-orange-500',
  teal: 'from-teal-500 to-teal-600 dark:from-teal-400 dark:to-teal-500',
  violet: 'from-violet-500 to-violet-600 dark:from-violet-400 dark:to-violet-500',
  fuchsia: 'from-fuchsia-500 to-fuchsia-600 dark:from-fuchsia-400 dark:to-fuchsia-500',
};

const colorClass = colorClasses[project.color as keyof typeof colorClasses] || colorClasses.mycelium;

const textColorClasses = {
  red: 'text-red-600 dark:text-red-400',
  amber: 'text-amber-600 dark:text-amber-400',
  purple: 'text-purple-600 dark:text-purple-400',
  cyan: 'text-cyan-600 dark:text-cyan-400',
  mycelium: 'text-mycelium-600 dark:text-mycelium-400',
  orange: 'text-orange-600 dark:text-orange-400',
  teal: 'text-teal-600 dark:text-teal-400',
  violet: 'text-violet-600 dark:text-violet-400',
  fuchsia: 'text-fuchsia-600 dark:text-fuchsia-400',
};

const textColor = textColorClasses[project.color as keyof typeof textColorClasses] || textColorClasses.mycelium;

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={project.title}
  description={project.tagline}
>
  <!-- Hero Section -->
  <div class="mb-12">
    <div class="flex items-center gap-3 mb-4">
      <a
        href={`${base}support`}
        class="text-gray-600 dark:text-gray-400 hover:text-mycelium-600 dark:hover:text-mycelium-400 transition-colors text-sm"
      >
        ← Retour aux projets
      </a>
    </div>

    <div class="flex items-start gap-6 mb-6">
      <div class="text-6xl">{project.emoji}</div>
      <div class="flex-1">
        <div class={`inline-block px-3 py-1 rounded-full text-xs font-medium mb-3 bg-gray-100 dark:bg-gray-800 ${textColor}`}>
          {project.category}
        </div>
        <h1 class={`text-5xl font-bold mb-3 bg-gradient-to-r ${colorClass} bg-clip-text text-transparent`}>
          {project.title}
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-400">{project.tagline}</p>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="flex gap-4 mb-8">
      <a
        href={project.website}
        target="_blank"
        rel="noopener noreferrer"
        class={`px-6 py-3 rounded-lg font-medium transition-all bg-gradient-to-r ${colorClass} text-white hover:shadow-lg hover:scale-105`}
      >
        🌐 Visiter le site
      </a>
      <a
        href="https://www.paypal.com/paypalme/dragovanmarkic"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 rounded-lg font-medium transition-all bg-white dark:bg-gray-800 border-2 border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 hover:border-mycelium-500 dark:hover:border-mycelium-500 hover:shadow-lg"
      >
        💝 Soutenir ce projet
      </a>
    </div>
  </div>

  <!-- Screenshot/Illustration -->
  {project.illustration && (
    <div class="mb-12 rounded-2xl overflow-hidden bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-800 dark:to-gray-900 p-8 border border-gray-200 dark:border-gray-700">
      <img
        src={`${base}${project.illustration.replace(/^\//, '')}`}
        alt={`${project.title} illustration`}
        class="w-full h-auto max-w-2xl mx-auto"
        style="max-height: 400px; object-fit: contain;"
      />
    </div>
  )}

  <!-- Main Content -->
  <div class="grid lg:grid-cols-3 gap-8 mb-12">
    <!-- Content Column -->
    <div class="lg:col-span-2">
      <article class="prose prose-lg dark:prose-invert max-w-none">
        <div set:html={project.htmlContent} />
      </article>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Funding Goal Card -->
      <div class="sticky top-8 bg-white dark:bg-gray-800 rounded-2xl border-2 border-gray-200 dark:border-gray-700 p-6 shadow-sm">
        <h3 class="text-lg font-bold mb-4 text-gray-900 dark:text-gray-100">Objectif de financement</h3>

        <div class="mb-6">
          <div class={`text-4xl font-bold mb-2 bg-gradient-to-r ${colorClass} bg-clip-text text-transparent`}>
            {project.fundingGoal.toLocaleString()} {project.fundingCurrency}
          </div>
          <div class="text-sm text-gray-600 dark:text-gray-400">par {project.fundingPeriod}</div>
        </div>

        <div class="space-y-4">
          <a
            href="https://www.paypal.com/paypalme/dragovanmarkic"
            target="_blank"
            rel="noopener noreferrer"
            class={`block w-full px-6 py-3 rounded-lg font-medium text-center transition-all bg-gradient-to-r ${colorClass} text-white hover:shadow-lg hover:scale-105`}
          >
            💝 Faire un don
          </a>

          <a
            href="https://opencollective.com/mycelium-ecosystem"
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full px-6 py-3 rounded-lg font-medium text-center transition-all bg-white dark:bg-gray-700 border-2 border-gray-200 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:border-mycelium-500 dark:hover:border-mycelium-500"
          >
            Open Collective
          </a>
        </div>

        <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
          <div class="text-xs text-gray-500 dark:text-gray-400">
            🔒 Paiements sécurisés<br/>
            💚 100% transparent<br/>
            🎁 Reçu fiscal disponible
          </div>
        </div>
      </div>

      <!-- Impact Card -->
      <div class="bg-gradient-to-br from-mycelium-50 to-green-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl border border-mycelium-200 dark:border-mycelium-800 p-6">
        <h3 class="text-lg font-bold mb-3 text-gray-900 dark:text-gray-100">💚 Impact</h3>
        <p class="text-sm text-gray-700 dark:text-gray-300">
          Votre soutien aide à maintenir ce projet indépendant, open source et accessible à tous.
        </p>
      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class={`bg-gradient-to-r ${colorClass} rounded-2xl p-8 md:p-12 text-white text-center`}>
    <h2 class="text-3xl font-bold mb-4">Soutenez {project.title}</h2>
    <p class="text-lg mb-6 opacity-90 max-w-2xl mx-auto">
      Chaque contribution, quelle que soit sa taille, fait une réelle différence pour maintenir ce projet vivant et accessible à tous.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="https://www.paypal.com/paypalme/dragovanmarkic"
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-4 rounded-lg font-bold bg-white text-gray-900 hover:bg-gray-100 transition-all hover:scale-105 shadow-lg"
      >
        💝 Faire un don maintenant
      </a>
      <a
        href={project.website}
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-4 rounded-lg font-bold bg-white/10 backdrop-blur-sm border-2 border-white/30 hover:bg-white/20 transition-all"
      >
        🌐 Découvrir le projet
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .prose {
    @apply text-gray-700 dark:text-gray-300;
  }

  .prose h1 {
    @apply text-gray-900 dark:text-gray-100;
  }

  .prose h2 {
    @apply text-gray-900 dark:text-gray-100 mt-12 mb-4;
  }

  .prose h3 {
    @apply text-gray-800 dark:text-gray-200 mt-8 mb-3;
  }

  .prose a {
    @apply text-mycelium-600 dark:text-mycelium-400;
  }

  .prose ul {
    @apply space-y-2;
  }

  .prose strong {
    @apply text-gray-900 dark:text-gray-100;
  }
</style>
