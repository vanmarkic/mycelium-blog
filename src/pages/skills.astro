---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSkills } from '../utils/markdown';

const contentDir = new URL('../../content', import.meta.url).pathname;
const skills = await getSkills(contentDir);

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Claude Code Skills" description="Exploring Claude Code skills and workflow automation">
  <div class="max-w-4xl mx-auto">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
        Claude Code Skills
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400">
        Custom skills and workflow automation built with Claude Code
      </p>
    </header>

    {skills.length === 0 ? (
      <p class="text-gray-600 dark:text-gray-400">No skills documented yet.</p>
    ) : (
      <div class="space-y-6">
        {skills.map(skill => (
          <article class="border border-gray-200 dark:border-gray-800 rounded-lg p-6 hover:border-mycelium-600 transition-colors">
            <a href={`${base}skills/${skill.slug}`} class="block">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 hover:text-mycelium-600 dark:hover:text-mycelium-400 transition-colors">
                {skill.frontmatter.title}
              </h2>
              {skill.frontmatter.description && (
                <p class="text-gray-600 dark:text-gray-400 mt-3">
                  {skill.frontmatter.description}
                </p>
              )}
              <div class="flex flex-wrap gap-2 mt-4">
                {skill.frontmatter.tags.map(tag => (
                  <span class="text-xs px-2 py-1 bg-gray-200 dark:bg-gray-800 text-mycelium-600 dark:text-mycelium-300 rounded">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
