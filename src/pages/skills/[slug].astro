---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSkills } from '../../utils/markdown';

export async function getStaticPaths() {
  const contentDir = new URL('../../../content', import.meta.url).pathname;
  const skills = await getSkills(contentDir);

  return skills.map(skill => ({
    params: { slug: skill.slug },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const { frontmatter, content } = skill;

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="max-w-4xl mx-auto">
    <header class="mb-8">
      <div class="inline-block px-3 py-1 bg-mycelium-900 text-mycelium-300 rounded-full text-sm mb-4">
        Claude Code Skill
      </div>

      <h1 class="text-4xl font-bold text-gray-100 mb-4">
        {frontmatter.title}
      </h1>

      <div class="flex flex-wrap gap-2">
        {frontmatter.tags.map(tag => (
          <span class="px-3 py-1 bg-gray-800 text-mycelium-300 rounded-full text-sm">
            {tag}
          </span>
        ))}
      </div>
    </header>

    <div class="prose prose-invert prose-lg max-w-none">
      <div set:html={content} />
    </div>

    <div class="mt-12">
      <a
        href={`${base}skills`}
        class="text-mycelium-400 hover:text-mycelium-300 transition-colors"
      >
        ← Back to all skills
      </a>
    </div>
  </article>
</BaseLayout>
